{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/prompt-lexicon-zh/schemas/entry.schema.json",
  "title": "Prompt Lexicon entries.yml",
  "description": "Schema for data/entries.yml. Defines category metadata and entry list.",
  "type": "object",
  "required": ["categories", "entries"],
  "additionalProperties": false,
  "properties": {
    "categories": {
      "type": "object",
      "description": "Five category metadata blocks keyed by category slug.",
      "required": ["structure", "logic", "cognition", "language", "quality"],
      "additionalProperties": false,
      "properties": {
        "structure": { "$ref": "#/$defs/category" },
        "logic": { "$ref": "#/$defs/category" },
        "cognition": { "$ref": "#/$defs/category" },
        "language": { "$ref": "#/$defs/category" },
        "quality": { "$ref": "#/$defs/category" }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "category": {
      "type": "object",
      "required": ["name", "order", "default_source"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 1 },
        "default_source": { "$ref": "#/$defs/source" }
      }
    },
    "source": {
      "type": "object",
      "required": ["name", "url"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": {
          "oneOf": [
            { "type": "string", "format": "uri", "pattern": "^https?://" },
            { "type": "null" }
          ]
        }
      }
    },
    "entry": {
      "type": "object",
      "required": [
        "term",
        "english",
        "slug",
        "category",
        "origin",
        "meaning",
        "prompt_usage",
        "short_usage",
        "example",
        "added",
        "last_verified"
      ],
      "additionalProperties": false,
      "properties": {
        "term": { "type": "string", "minLength": 1 },
        "english": { "type": "string", "minLength": 1 },
        "slug": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "category": {
          "type": "string",
          "enum": ["structure", "logic", "cognition", "language", "quality"]
        },
        "origin": { "type": "string", "minLength": 1 },
        "meaning": { "type": "string", "minLength": 1, "maxLength": 30 },
        "prompt_usage": {
          "type": "string",
          "minLength": 30,
          "maxLength": 50
        },
        "short_usage": {
          "type": "string",
          "minLength": 15,
          "maxLength": 25
        },
        "example": { "type": "string", "minLength": 1 },
        "added": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "last_verified": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "source": { "$ref": "#/$defs/source" }
      }
    }
  }
}
